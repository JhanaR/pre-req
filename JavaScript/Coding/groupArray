const data = [
  { category: 'fruit', name: 'apple' },
  { category: 'vegetable', name: 'carrot' },
  { category: 'fruit', name: 'banana' },
  { category: 'vegetable', name: 'spinach' }
];

function groupByCategory(arr) {
  return arr.reduce((result, item) => {
    const { category, name } = item; //destructuring the item

    if (!result[category]) {
      result[category] = []; //// Create new array if category not present
    }

    result[category].push({ name }); // Push only the name into the category array
    return result;
  }, {});// Initial value is an empty object
}

console.log(groupByCategory(data));
// Output:
// {
//   fruit: [{ name: 'apple' }, { name: 'banana' }],
//   vegetable: [{ name: 'carrot' }, { name: 'spinach' }]
// }
